{
  "manifest_version": 3,
  "name": "Lee Relay — AI Meeting Room",
  "version": "3.0.3",
  "description": "Let ChatGPT, Claude, Gemini, and Copilot discuss one topic in a verified Chrome Side Panel.",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "downloads",
    "activeTab",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Lee Relay"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_permissions": [
    "debugger"
  ]
}

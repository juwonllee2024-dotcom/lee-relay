{
  "manifest_version": 3,
  "name": "Lee Relay Bot",
  "version": "4.3.1",
  "description": "Persistent multi-AI Rooms with Playbooks, bounded Runs, Reports, Context Guard, @AI handoffs, and verified background-tab relay.",
  "icons": {
    "16": "assets/lee-relay-logo.png",
    "48": "assets/lee-relay-logo.png",
    "128": "assets/lee-relay-logo.png"
  },
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "downloads",
    "activeTab",
    "alarms",
    "sidePanel",
    "debugger"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Lee Relay",
    "default_icon": {
      "16": "assets/lee-relay-logo.png",
      "48": "assets/lee-relay-logo.png",
      "128": "assets/lee-relay-logo.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "response-capture-policy.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
